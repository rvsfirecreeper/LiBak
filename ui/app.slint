import { ListView, Palette } from "std-widgets.slint";
// Bundled so the UI looks the same everywhere (SIL OFL 1.1, see fonts/OFL.txt).
import "fonts/GoogleSans-Regular.ttf";
import "fonts/GoogleSans-Bold.ttf";

export struct BackupItem {
    name: string,
    time: string,
    id: string,
}

// Every colour in the UI comes from here, nothing else. These are the defaults;
// src/theme.rs overrides them from ~/.config/libak/theme.conf when that file exists.
// (The standard Slint buttons and text fields can't be recoloured, which is why the
// controls below are drawn by hand.)
export global Theme {
    in property <color> accent: #60cdff;
    in property <color> accent-text: #101114;
    in property <color> page: #14161a;
    in property <color> panel: #1b1e23;
    in property <color> line: #2a2e35;
    in property <color> text: #e7e9ee;
    in property <color> muted: #8b919c;
    in property <color> ok: #7bd88f;
    in property <color> err: #ff7b72;
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();

    forward-focus: fs;
    height: 36px;
    min-width: max(88px, label.preferred-width + 32px);
    preferred-width: self.min-width;
    border-radius: 4px;
    border-width: 1px;
    border-color: !root.enabled ? Theme.line
        : fs.has-focus ? Theme.text
        : root.primary ? Theme.accent
        : Theme.line;
    background: !root.enabled ? Theme.panel
        : root.primary ? (ta.pressed ? Theme.accent.darker(0.25)
            : ta.has-hover ? Theme.accent.brighter(0.2)
            : Theme.accent)
        : (ta.pressed ? #ffffff1f : ta.has-hover ? #ffffff10 : transparent);

    label := Text {
        text: root.text;
        color: !root.enabled ? Theme.muted
            : root.primary ? Theme.accent-text
            : Theme.text;
        font-weight: 700;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component Field inherits Rectangle {
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in-out property <string> text <=> input.text;
    callback accepted();

    forward-focus: input;
    height: 36px;
    border-radius: 4px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    background: Theme.panel;
    clip: true;

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    if root.text == "": Text {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.muted;
        font-size: 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        enabled: root.enabled;
        color: root.enabled ? Theme.text : Theme.muted;
        font-size: 14px;
        vertical-alignment: center;
        input-type: root.password ? InputType.password : InputType.text;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.accent-text;
        accepted => { root.accepted(); }
    }
}

component Busy inherits Rectangle {
    height: 3px;
    background: Theme.line;
    clip: true;
    Rectangle {
        width: parent.width * 0.3;
        height: parent.height;
        background: Theme.accent;
        x: (parent.width + self.width) * mod(animation-tick() / 1.4s, 1.0) - self.width;
    }
}

component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    min-width: label.preferred-width;
    label := Text {
        text: root.text;
        color: root.active ? Theme.text : (ta.has-hover ? Theme.text : Theme.muted);
        font-weight: root.active ? 700 : 400;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // underline on the active tab
    Rectangle {
        y: parent.height - self.height;
        height: 2px;
        background: root.active ? Theme.accent : transparent;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component Label inherits Text {
    color: Theme.text;
    font-weight: 700;
    font-size: 13px;
}

component Hint inherits Text {
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

export component AppWindow inherits Window {
    title: "LiBak";
    default-font-family: "Google Sans";
    background: Theme.page;
    min-width: 520px;
    min-height: 600px;

    // Only the list scrollbars still come from the standard widgets; keep them on
    // their dark variant whatever the system theme is.
    init => { Palette.color-scheme = ColorScheme.dark; }

    // Shared state
    in property <bool> busy;
    in property <string> message;
    in property <bool> message-is-error;
    in-out property <int> page: 0;

    // Backup page: paths to skip (a folder skips everything inside it)
    in property <[string]> exclusions;
    callback add-exclusion(string);
    callback remove-exclusion(int);

    // Restore page
    in property <[BackupItem]> backups;
    in-out property <int> selected: -1;

    // Passwords are handed over as callback arguments and the field is cleared
    // straight away; the Rust side copies them into a zeroizing buffer.
    callback start-backup(string, string, string);
    callback start-restore(int, string, string);
    callback refresh-backups();

    VerticalLayout {
        // Title and tabs
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 28px;
                Text {
                    text: "LiBak";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Tab {
                    text: "Back up";
                    active: root.page == 0;
                    clicked => { root.page = 0; }
                }
                Tab {
                    text: "Restore";
                    active: root.page == 1;
                    clicked => { root.page = 1; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.line;
        }

        // Pages
        Rectangle {
            vertical-stretch: 1;

            if root.page == 0: VerticalLayout {
                padding: 20px;
                spacing: 8px;
                alignment: start;

                Label { text: "Folder to back up"; }
                source := Field {
                    placeholder: "/home/you/Documents";
                    enabled: !root.busy;
                }
                Label { text: "Backup name"; }
                name := Field {
                    placeholder: "Documents";
                    enabled: !root.busy;
                }

                Rectangle { height: 6px; }
                Label { text: "Skip these (optional)"; }
                Hint {
                    text: "A folder skips everything inside it, e.g. ~/.local/share/Steam. Relative paths start from the folder above.";
                }
                HorizontalLayout {
                    spacing: 8px;
                    skip := Field {
                        placeholder: "~/.local/share/Steam";
                        enabled: !root.busy;
                        horizontal-stretch: 1;
                        accepted => {
                            root.add-exclusion(self.text);
                            self.text = "";
                        }
                    }
                    Btn {
                        text: "Add";
                        enabled: !root.busy && skip.text != "";
                        clicked => {
                            root.add-exclusion(skip.text);
                            skip.text = "";
                        }
                    }
                }
                if root.exclusions.length > 0: ListView {
                    height: min(root.exclusions.length * 40px, 120px);
                    for ex[i] in root.exclusions: HorizontalLayout {
                        height: 40px;
                        spacing: 8px;
                        Text {
                            text: ex;
                            color: Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Btn {
                            text: "Remove";
                            enabled: !root.busy;
                            clicked => { root.remove-exclusion(i); }
                        }
                    }
                }

                Rectangle { height: 6px; }
                Label { text: "Password"; }
                backup-pw := Field {
                    password: true;
                    placeholder: "Password";
                    enabled: !root.busy;
                    accepted => {
                        root.start-backup(source.text, name.text, self.text);
                        self.text = "";
                    }
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: "Back up now";
                        primary: true;
                        enabled: !root.busy && source.text != "" && backup-pw.text != "";
                        clicked => {
                            root.start-backup(source.text, name.text, backup-pw.text);
                            backup-pw.text = "";
                        }
                    }
                }
            }

            if root.page == 1: VerticalLayout {
                padding: 20px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Label {
                        text: "Your backups";
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Btn {
                        text: "Refresh";
                        enabled: !root.busy;
                        clicked => { root.refresh-backups(); }
                    }
                }
                if root.backups.length == 0: Hint {
                    text: "No backups yet. Make one on the Back up page.";
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 100px;
                    background: Theme.panel;
                    border-radius: 4px;
                    ListView {
                        for item[i] in root.backups: Rectangle {
                            height: 38px;
                            background: root.selected == i ? #ffffff0f : (row.has-hover ? #ffffff08 : transparent);
                            // accent bar on the selected row
                            Rectangle {
                                x: 0;
                                width: 3px;
                                background: Theme.accent;
                                visible: root.selected == i;
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                spacing: 12px;
                                Text {
                                    text: item.name == "" ? "(unnamed)" : item.name;
                                    color: Theme.text;
                                    font-weight: root.selected == i ? 700 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: item.time + "  ·  " + item.id;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                            row := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.selected = i; }
                            }
                        }
                    }
                }

                Rectangle { height: 6px; }
                Label { text: "Restore into (must be an empty folder)"; }
                target := Field {
                    placeholder: "/home/you/restored";
                    enabled: !root.busy;
                }
                Label { text: "Password"; }
                restore-pw := Field {
                    password: true;
                    placeholder: "Password";
                    enabled: !root.busy;
                    accepted => {
                        root.start-restore(root.selected, target.text, self.text);
                        self.text = "";
                    }
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    alignment: start;
                    Btn {
                        text: "Restore";
                        primary: true;
                        enabled: !root.busy && root.selected >= 0 && target.text != "" && restore-pw.text != "";
                        clicked => {
                            root.start-restore(root.selected, target.text, restore-pw.text);
                            restore-pw.text = "";
                        }
                    }
                }
            }
        }

        // Status area
        if root.busy: Busy { }
        if root.message != "": Rectangle {
            height: msg.preferred-height + 24px;
            background: Theme.panel;
            Rectangle {
                x: 0;
                width: 3px;
                background: root.message-is-error ? Theme.err : Theme.ok;
            }
            msg := Text {
                x: 20px;
                y: 12px;
                width: parent.width - 40px;
                text: root.message;
                color: root.message-is-error ? Theme.err : Theme.ok;
                font-size: 13px;
                wrap: word-wrap;
            }
        }
    }
}
